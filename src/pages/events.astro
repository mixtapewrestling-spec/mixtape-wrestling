---
export const prerender = true;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Events — miXtape Wrestling</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow+Condensed:wght@400;600;700&family=Barlow:wght@400;500&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/js/cart.css" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --black:#0a0a0c;--charcoal:#111116;--surface:#17171e;--border:#2a2a38;
      --cyan:#00d4ff;--cyan-dim:#00a8cc;--purple:#9b59ff;--violet:#c77dff;
      --teal:#00f5d4;--white:#f0f0f8;--muted:#8888aa;
      --font-display:'Bebas Neue',sans-serif;
      --font-ui:'Barlow Condensed',sans-serif;
      --font-body:'Barlow',sans-serif;
    }
    html { scroll-behavior: smooth; }
    body { background:var(--black);color:var(--white);font-family:var(--font-body);overflow-x:hidden; }
    body::before {
      content:'';position:fixed;inset:0;
      background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
      pointer-events:none;z-index:9999;opacity:0.35;
    }
    .holo-text {
      background:linear-gradient(135deg,#00d4ff,#9b59ff,#ff6ec7,#00f5d4,#00d4ff);
      background-size:300% 300%;-webkit-background-clip:text;-webkit-text-fill-color:transparent;
      background-clip:text;animation:holo-shift 4s ease infinite;
    }
    @keyframes holo-shift{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
    nav {
      position:fixed;top:0;left:0;right:0;z-index:100;
      display:flex;align-items:center;justify-content:space-between;
      padding:0 2.5rem;height:64px;
      background:rgba(10,10,12,0.88);backdrop-filter:blur(12px);
      border-bottom:1px solid var(--border);
    }
    .nav-logo{font-family:var(--font-display);font-size:1.6rem;letter-spacing:0.05em;text-decoration:none;line-height:1;}
    .nav-links{display:flex;gap:2rem;list-style:none;}
    .nav-links a{font-family:var(--font-ui);font-size:0.95rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;color:var(--muted);text-decoration:none;transition:color 0.2s;}
    .nav-links a:hover,.nav-links a.active{color:var(--cyan);}
    .nav-right{display:flex;align-items:center;gap:1rem;}
    .nav-cta{font-family:var(--font-ui);font-size:0.85rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:var(--black);background:var(--cyan);padding:0.5rem 1.25rem;text-decoration:none;clip-path:polygon(8px 0%,100% 0%,calc(100% - 8px) 100%,0% 100%);transition:background 0.2s,transform 0.2s;}
    .nav-cta:hover{background:var(--teal);transform:translateY(-1px);}
    .page-header{padding:8rem 2rem 3rem;text-align:center;position:relative;overflow:hidden;}
    .page-header::after{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(0,212,255,0.04) 1px,transparent 1px),linear-gradient(90deg,rgba(0,212,255,0.04) 1px,transparent 1px);background-size:60px 60px;mask-image:radial-gradient(ellipse 80% 80% at 50% 50%,black 30%,transparent 100%);pointer-events:none;}
    .page-header-glow{position:absolute;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(155,89,255,0.12) 0%,rgba(0,212,255,0.06) 40%,transparent 70%);top:50%;left:50%;transform:translate(-50%,-50%);pointer-events:none;}
    .page-eyebrow{font-family:var(--font-ui);font-size:0.8rem;font-weight:700;letter-spacing:0.35em;text-transform:uppercase;color:var(--cyan);margin-bottom:0.75rem;position:relative;z-index:1;}
    .page-title{font-family:var(--font-display);font-size:clamp(3rem,10vw,7rem);line-height:0.9;letter-spacing:0.02em;position:relative;z-index:1;}
    .events-layout{max-width:1100px;margin:0 auto;padding:3rem 2rem 6rem;}
    .event-main{background:var(--surface);border:1px solid var(--border);clip-path:polygon(0 0,calc(100% - 24px) 0,100% 24px,100% 100%,0 100%);overflow:hidden;}
    .event-banner{background:linear-gradient(135deg,rgba(155,89,255,0.2),rgba(0,212,255,0.1));border-bottom:1px solid var(--border);padding:2.5rem 2rem;position:relative;overflow:hidden;}
    .event-banner::before{content:'';position:absolute;inset:0;background-image:linear-gradient(rgba(0,212,255,0.06) 1px,transparent 1px),linear-gradient(90deg,rgba(0,212,255,0.06) 1px,transparent 1px);background-size:40px 40px;pointer-events:none;}
    .event-label{font-family:var(--font-ui);font-size:0.7rem;font-weight:700;letter-spacing:0.4em;text-transform:uppercase;color:var(--cyan);margin-bottom:0.75rem;position:relative;z-index:1;}
    .event-name{font-family:var(--font-display);font-size:clamp(2rem,5vw,3.5rem);line-height:0.95;letter-spacing:0.03em;position:relative;z-index:1;margin-bottom:1.25rem;}
    .event-details{display:flex;flex-wrap:wrap;gap:1.5rem;position:relative;z-index:1;}
    .event-detail{font-family:var(--font-ui);font-size:0.85rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--muted);}
    .event-detail span{color:var(--white);}
    .event-body{padding:2rem;}
    .event-section-title{font-family:var(--font-ui);font-size:0.7rem;font-weight:700;letter-spacing:0.4em;text-transform:uppercase;color:var(--muted);margin-bottom:1.25rem;padding-bottom:0.75rem;border-bottom:1px solid var(--border);}
    .tier-list{display:flex;flex-direction:column;gap:0.75rem;}
    .tier-row{display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:1.25rem;padding:1.25rem 1.5rem;background:var(--charcoal);border:1px solid var(--border);clip-path:polygon(0 0,calc(100% - 12px) 0,100% 12px,100% 100%,12px 100%,0 calc(100% - 12px));transition:border-color 0.2s;}
    .tier-row.sold-out{opacity:0.5;pointer-events:none;}
    .tier-info{display:flex;flex-direction:column;gap:0.25rem;}
    .tier-name{font-family:var(--font-display);font-size:1.5rem;letter-spacing:0.05em;}
    .tier-avail{font-family:var(--font-ui);font-size:0.75rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;}
    .tier-avail.in-stock{color:var(--teal);}
    .tier-avail.almost-gone{color:#ff9f43;}
    .tier-avail.sold-out{color:var(--muted);}
    .tier-price{font-family:var(--font-display);font-size:2rem;color:var(--cyan);letter-spacing:0.03em;text-align:right;min-width:80px;}
    .tier-add-btn{font-family:var(--font-ui);font-size:0.75rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;color:var(--black);background:var(--cyan);border:none;cursor:pointer;padding:0.55rem 1.1rem;clip-path:polygon(6px 0%,100% 0%,calc(100% - 6px) 100%,0% 100%);transition:background 0.2s,transform 0.2s;white-space:nowrap;}
    .tier-add-btn:hover{background:var(--teal);transform:translateY(-1px);}
    footer{border-top:1px solid var(--border);padding:3rem 2rem;text-align:center;}
    .footer-logo{font-family:var(--font-display);font-size:2.5rem;letter-spacing:0.05em;margin-bottom:1rem;}
    .footer-links{display:flex;justify-content:center;gap:2rem;list-style:none;margin-bottom:2rem;flex-wrap:wrap;}
    .footer-links a{font-family:var(--font-ui);font-size:0.8rem;font-weight:600;letter-spacing:0.15em;text-transform:uppercase;color:var(--muted);text-decoration:none;transition:color 0.2s;}
    .footer-links a:hover{color:var(--cyan);}
    .footer-copy{font-family:var(--font-ui);font-size:0.75rem;letter-spacing:0.1em;color:var(--border);text-transform:uppercase;}
    @media(max-width:768px){nav{padding:0 1.25rem}.nav-links{display:none}.tier-row{grid-template-columns:1fr auto;gap:0.75rem}.tier-price{display:none}}
  </style>
</head>
<body>
  <nav>
    <a href="/" class="nav-logo"><span class="holo-text">miX</span><span style="color:var(--white)">tape</span></a>
    <ul class="nav-links">
      <li><a href="/events" class="active">Events</a></li>
      <li><a href="/store">Store</a></li>
      <li><a href="/roster">Roster</a></li>
      <li><a href="/about">About</a></li>
    </ul>
    <div class="nav-right">
      <button class="cart-icon-btn" onclick="openCart()" aria-label="Open cart">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <span class="cart-count">0</span>
      </button>
      <a href="/events" class="nav-cta">Get Tickets</a>
    </div>
  </nav>

  <header class="page-header">
    <div class="page-header-glow"></div>
    <p class="page-eyebrow">Live Events</p>
    <h1 class="page-title"><span class="holo-text">Upcoming</span><br><span style="color:var(--white)">Shows</span></h1>
  </header>

  <div class="events-layout">
    <div class="event-main">
      <div class="event-banner">
        <p class="event-label">Next Event</p>
        <h2 class="event-name"><span class="holo-text">Vol. 1 — Press Play</span></h2>
        <div class="event-details">
          <div class="event-detail">Date: <span>TBA</span></div>
          <div class="event-detail">Venue: <span>TBA</span></div>
        </div>
      </div>
      <div class="event-body">
        <p class="event-section-title">Select Your Section</p>
        <div class="tier-list" id="tierList"></div>
      </div>
    </div>
  </div>

  <footer>
    <div class="footer-logo"><span class="holo-text">miX</span><span style="color:var(--white)">tape</span></div>
    <ul class="footer-links">
      <li><a href="/events">Events</a></li>
      <li><a href="/store">Store</a></li>
      <li><a href="/roster">Roster</a></li>
      <li><a href="/about">About</a></li>
      <li><a href="/contact">Contact</a></li>
    </ul>
    <p class="footer-copy">© 2026 miXtape Wrestling. All rights reserved.</p>
  </footer>

  <!-- Cart Drawer -->
  <div class="cart-overlay" id="cartOverlay" onclick="closeCart()"></div>
  <div class="cart-drawer" id="cartDrawer">
    <div class="cart-drawer-header">
      <div class="cart-drawer-title"><span class="holo-text">Your Cart</span></div>
      <button class="cart-close-btn" onclick="closeCart()">✕</button>
    </div>
    <div class="cart-drawer-body">
      <div class="cart-items" id="cartItems">
        <p class="cart-empty">Your cart is empty</p>
      </div>
    </div>
    <div class="cart-drawer-footer">
      <div class="cart-field">
        <label for="cartName">Full Name</label>
        <input type="text" id="cartName" placeholder="Your name" autocomplete="name" />
      </div>
      <div class="cart-field">
        <label for="cartEmail">Email Address</label>
        <input type="email" id="cartEmail" placeholder="ticket@email.com" autocomplete="email" />
      </div>
      <div class="cart-total-row">
        <span>Total</span>
        <span id="cartTotal">$0.00</span>
      </div>
      <button class="cart-checkout-btn" id="cartCheckoutBtn" disabled onclick="cartCheckout()">Checkout</button>
    </div>
  </div>

  <script src="/js/cart.js" is:inline></script>
  <script>
    const TIERS = [
      { id: 1, name: 'Ringside',          priceCents: 3500, stripePrice: 'price_1TfX1wAAiPqE8TkfHcv0trDs', capacity: 40 },
      { id: 2, name: 'Row 2',             priceCents: 3500, stripePrice: 'price_1TfX2cAAiPqE8TkfYgWPoAo4', capacity: 40 },
      { id: 3, name: 'Row 3',             priceCents: 3500, stripePrice: 'price_1TfX3LAAiPqE8TkfiW4dkQbY',  capacity: 40 },
      { id: 4, name: 'General Admission', priceCents: 2750, stripePrice: 'price_1TfX46AAiPqE8Tkf3VJZ85zN', capacity: 150 },
    ];

    function getAvailLabel(capacity) {
      if (capacity <= 0)  return { text: 'Sold Out!',    cls: 'sold-out' };
      if (capacity <= 20) return { text: 'Almost Gone!', cls: 'almost-gone' };
      return                     { text: 'In Stock',     cls: 'in-stock' };
    }

    function buildTiers() {
      var list = document.getElementById('tierList');
      TIERS.forEach(function(t) {
        var price = (t.priceCents / 100).toFixed(2);
        var avail = getAvailLabel(t.capacity);
        var soldOut = t.capacity <= 0;
        var row = document.createElement('div');
        row.className = 'tier-row' + (soldOut ? ' sold-out' : '');
        row.innerHTML =
          '<div class="tier-info">' +
            '<div class="tier-name">' + t.name + '</div>' +
            '<div class="tier-avail ' + avail.cls + '">' + avail.text + '</div>' +
          '</div>' +
          '<div class="tier-price">$' + price + '</div>' +
          '<button class="tier-add-btn">' + (soldOut ? 'Sold Out' : 'Add to Cart') + '</button>';
        if (!soldOut) {
          row.querySelector('.tier-add-btn').addEventListener('click', function() {
            addToCart({
              name: t.name,
              category: 'Vol. 1 — Press Play',
              priceCents: t.priceCents,
              stripePrice: t.stripePrice,
              tierId: t.id,
              qty: 1,
            });
          });
        }
        list.appendChild(row);
      });
    }

    buildTiers();
  </script>
</body>
</html>
