---
export const prerender = true;

const db = (Astro.locals as any).runtime?.env?.DB;

let event: any = null;
let ticketTypes: any[] = [];
let soldCounts: Record<number, number> = {};

if (db) {
  event = await db
    .prepare("SELECT * FROM events WHERE active = 1 ORDER BY id DESC LIMIT 1")
    .first();

  if (event) {
    const types = await db
      .prepare("SELECT * FROM ticket_types WHERE event_id = ?")
      .bind(event.id)
      .all();
    ticketTypes = types.results ?? [];

    for (const t of ticketTypes) {
      const row: any = await db
        .prepare("SELECT COUNT(*) as cnt FROM tickets WHERE ticket_type_id = ?")
        .bind(t.id)
        .first();
      soldCounts[t.id] = row?.cnt ?? 0;
    }
  }
}
